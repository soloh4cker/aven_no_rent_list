{
  "manifest_version": 3,
  "name": "Aven No-Rent Alert",
  "version": "1.2.0",
  "description": "Warns staff when the displayed Aven guest matches a locally managed no-rent list.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.synxis.com/*",
    "https://*.avenhospitality.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Aven No-Rent Alert",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.synxis.com/*",
        "https://*.avenhospitality.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ]
}
